{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldparts.dev/schemas/component-manifest-0.1.schema.json",
  "title": "worldparts component manifest (format 0.1)",
  "description": "Normative definition of a worldparts component manifest (docs/design.md section 4). A manifest describes a physical component for an AI agent: ports, parameters with units and limits, inputs, states, observables, modes, operating envelope, code-emitted warnings, canonical scenarios, behavioural contracts, implementation bindings and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "version",
    "name",
    "summary",
    "description",
    "fidelity",
    "ports",
    "parameters",
    "observables",
    "scenarios",
    "contracts",
    "implementations",
    "provenance"
  ],
  "properties": {
    "manifest_version": {"const": "0.1", "description": "Manifest format version."},
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "Dotted lowercase namespace; the last segment is the short alias."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of this component definition."
    },
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "pattern": "^[^\\n]+$", "description": "One line."},
    "description": {"type": "string", "minLength": 1, "description": "Markdown: what it models and what it does not."},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "uniqueItems": true},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ifc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity"],
          "properties": {
            "entity": {"type": "string", "pattern": "^Ifc[A-Za-z]+$"},
            "predefined_type": {"type": "string"}
          }
        },
        "brick": {"type": "string"},
        "other": {"type": "object"}
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "assumptions"],
      "properties": {
        "level": {"enum": ["qualitative", "lumped_quasi_steady", "lumped_dynamic", "distributed"]},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/port"}},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "states": {"type": "array", "items": {"$ref": "#/$defs/state"}},
    "observables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observable"}},
    "modes": {"type": "array", "items": {"$ref": "#/$defs/mode"}},
    "envelope": {"type": "array", "items": {"$ref": "#/$defs/envelope_rule"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "scenarios": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/scenario"}},
    "contracts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/contract"}},
    "implementations": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python"],
          "properties": {
            "python": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Import path module:Class of the reference implementation."
            },
            "notes": {"type": "string"}
          }
        },
        "modelica": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class"],
          "properties": {
            "class": {"type": "string"},
            "library": {"type": "string"},
            "notes": {"type": "string"}
          }
        },
        "wntr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["element"],
          "properties": {
            "element": {"type": "string"},
            "notes": {"type": "string"}
          }
        }
      },
      "additionalProperties": {"type": "object"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "sources", "data", "license", "data_license"],
      "properties": {
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^https?://"},
              "citation": {"type": "string"},
              "notes": {"type": "string"}
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acquisition", "notes"],
          "properties": {
            "acquisition": {"enum": ["generic", "estimate", "datasheet", "digitized", "measured", "standard"]},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "license": {"type": "string", "minLength": 1},
        "data_license": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "unit": {
      "enum": ["1", "%", "Pa", "kPa", "bar", "m", "mm", "m/s", "m2", "m3", "L", "kg/s", "L/s", "L/min", "m3/h", "degC", "K", "W", "kW", "s", "min", "h", "rpm", "mW/cm2", "mJ/cm2", "kg/m3", "kWh/m3"],
      "description": "Unit vocabulary of design section 3.1."
    },
    "pressure_reference": {"enum": ["gauge", "absolute", "difference"]},
    "variable_quantity": {
      "enum": ["temperature_difference"],
      "description": "What a number means when its unit alone is ambiguous. temperature_difference: a temperature difference (e.g. a rise in K), converted between units by scale only (35 K = 35 degC = 63 degF); only with unit K or degC."
    },
    "temperature_difference_unit": {
      "if": {"required": ["quantity"], "properties": {"quantity": {"const": "temperature_difference"}}},
      "then": {"properties": {"unit": {"enum": ["K", "degC"]}}}
    },
    "expression": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "number"}, {"type": "boolean"}],
      "description": "An expression of the worldparts expression language (design section 3.4)."
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "medium", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "type": {"enum": ["fluid"]},
        "medium": {"enum": ["water"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "description", "type", "default"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string", "minLength": 1},
        "type": {"enum": ["number", "integer", "string", "boolean", "table"]}
      },
      "allOf": [
        {"$ref": "#/$defs/temperature_difference_unit"},
        {
          "if": {"properties": {"type": {"const": "number"}}},
          "then": {
            "additionalProperties": false,
            "required": ["unit"],
            "properties": {
              "name": true, "description": true, "type": true,
              "unit": {"$ref": "#/$defs/unit"},
              "default": {"type": "number"},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "pressure_reference": {"$ref": "#/$defs/pressure_reference"},
              "quantity": {"$ref": "#/$defs/variable_quantity"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "integer"}}},
          "then": {
            "additionalProperties": false,
            "required": ["unit"],
            "properties": {
              "name": true, "description": true, "type": true,
              "unit": {"$ref": "#/$defs/unit"},
              "default": {"type": "integer"},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "string"}}},
          "then": {
            "additionalProperties": false,
            "required": ["enum"],
            "properties": {
              "name": true, "description": true, "type": true,
              "default": {"type": "string"},
              "enum": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}},
          "then": {
            "additionalProperties": false,
            "properties": {
              "name": true, "description": true, "type": true,
              "default": {"type": "boolean"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "table"}}},
          "then": {
            "additionalProperties": false,
            "required": ["columns"],
            "properties": {
              "name": true, "description": true, "type": true,
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "unit"],
                  "properties": {
                    "name": {"$ref": "#/$defs/name"},
                    "unit": {"$ref": "#/$defs/unit"},
                    "description": {"type": "string"},
                    "pressure_reference": {"$ref": "#/$defs/pressure_reference"},
                    "minimum": {"type": "number", "description": "Hard lower limit of every cell in this column (column unit)."},
                    "maximum": {"type": "number", "description": "Hard upper limit of every cell in this column (column unit)."}
                  }
                }
              },
              "min_rows": {"type": "integer", "minimum": 1, "description": "Minimum number of rows (default 1)."},
              "default": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
              }
            }
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "unit", "default"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string", "minLength": 1},
        "unit": {"$ref": "#/$defs/unit"},
        "default": {"type": "number"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "pressure_reference": {"$ref": "#/$defs/pressure_reference"},
        "quantity": {"$ref": "#/$defs/variable_quantity"}
      },
      "allOf": [{"$ref": "#/$defs/temperature_difference_unit"}]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "unit", "steady"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string", "minLength": 1},
        "unit": {"$ref": "#/$defs/unit"},
        "steady": {"enum": ["settle", "hold"], "description": "settle: solve() sets it to equilibrium; hold: solve() keeps the current value."},
        "default": {"type": "number", "description": "Initial value when the implementation does not set one."},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "pressure_reference": {"$ref": "#/$defs/pressure_reference"},
        "quantity": {"$ref": "#/$defs/variable_quantity"}
      },
      "allOf": [{"$ref": "#/$defs/temperature_difference_unit"}]
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "unit"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string", "minLength": 1},
        "unit": {"$ref": "#/$defs/unit"},
        "pressure_reference": {"$ref": "#/$defs/pressure_reference"},
        "quantity": {"$ref": "#/$defs/variable_quantity"}
      },
      "allOf": [{"$ref": "#/$defs/temperature_difference_unit"}]
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "condition", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "condition": {"$ref": "#/$defs/expression"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "envelope_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "condition", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "severity": {"enum": ["info", "warning"]},
        "condition": {"$ref": "#/$defs/expression"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "description"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "severity": {"enum": ["info", "warning"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "value": {
      "oneOf": [
        {"type": "number"},
        {"type": "string"},
        {"type": "boolean"},
        {"type": "array", "items": {"type": "array", "items": {"type": ["number", "string"]}}}
      ]
    },
    "values": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/value"}
    },
    "system_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "type": {"type": "string", "minLength": 1},
        "parameters": {"$ref": "#/$defs/values"},
        "inputs": {"$ref": "#/$defs/values"},
        "states": {"$ref": "#/$defs/values", "description": "Optional state values (declared units), applied after parameters and inputs."}
      }
    },
    "system_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "description": {"type": "string"},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/system_component"}},
        "connections": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"}
          }
        }
      }
    },
    "quantity": {"oneOf": [{"type": "number"}, {"type": "string", "minLength": 1}]},
    "event": {
      "oneOf": [
        {
          "type": "object",
          "description": "Set values at time 'at'.",
          "additionalProperties": false,
          "required": ["at", "set"],
          "properties": {
            "at": {"$ref": "#/$defs/quantity"},
            "set": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/value"}
            }
          }
        },
        {
          "type": "object",
          "description": "Ramp values linearly from [start, end] between 'at' and 'at' + 'over' (one set event per step; docs/design.md section 13.2).",
          "additionalProperties": false,
          "required": ["at", "ramp", "over"],
          "properties": {
            "at": {"$ref": "#/$defs/quantity"},
            "ramp": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/quantity"}}
            },
            "over": {"$ref": "#/$defs/quantity"}
          }
        }
      ]
    },
    "simulate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration"],
      "properties": {
        "duration": {"$ref": "#/$defs/quantity"},
        "step": {"$ref": "#/$defs/quantity"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
      }
    },
    "path": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["variable", "value"],
          "properties": {
            "variable": {"$ref": "#/$defs/path"},
            "value": {"type": ["number", "null"]},
            "abs_tol": {"type": "number", "minimum": 0},
            "rel_tol": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["variable"],
          "anyOf": [{"required": ["min"]}, {"required": ["max"]}],
          "properties": {
            "variable": {"$ref": "#/$defs/path"},
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["warning", "present"],
          "properties": {
            "warning": {"$ref": "#/$defs/path"},
            "present": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "is"],
          "properties": {
            "mode": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "is": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "system", "expect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "description": {"type": "string", "minLength": 1},
        "system": {"$ref": "#/$defs/system_body"},
        "simulate": {"$ref": "#/$defs/simulate"},
        "expect": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expectation"}}
      }
    },
    "sweep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["variable", "from", "to", "steps"],
          "properties": {
            "variable": {"$ref": "#/$defs/path"},
            "from": {"type": "number"},
            "to": {"type": "number"},
            "steps": {"type": "integer", "minimum": 2}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["variable", "values"],
          "properties": {
            "variable": {"$ref": "#/$defs/path"},
            "values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value"}}
          }
        }
      ]
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "variable", "direction"],
          "properties": {
            "type": {"const": "monotonic"},
            "variable": {"$ref": "#/$defs/path"},
            "direction": {"enum": ["increasing", "decreasing"]},
            "strict": {"type": "boolean"},
            "tolerance": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "variable"],
          "anyOf": [{"required": ["min"]}, {"required": ["max"]}],
          "properties": {
            "type": {"const": "bounds"},
            "variable": {"$ref": "#/$defs/path"},
            "min": {"$ref": "#/$defs/expression"},
            "max": {"$ref": "#/$defs/expression"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "left", "right"],
          "anyOf": [{"required": ["abs_tol"]}, {"required": ["rel_tol"]}],
          "properties": {
            "type": {"const": "equal"},
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"},
            "abs_tol": {"type": "number", "minimum": 0},
            "rel_tol": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "code", "condition"],
          "properties": {
            "type": {"const": "warning_iff"},
            "code": {"$ref": "#/$defs/path"},
            "condition": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "scenario", "check"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "description": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "sweep": {"$ref": "#/$defs/sweep"},
        "check": {"$ref": "#/$defs/check"}
      }
    }
  }
}
