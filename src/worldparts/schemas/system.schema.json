{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldparts.dev/schemas/system-0.1.schema.json",
  "title": "worldparts system document (0.1)",
  "description": "Language-neutral description of a composed worldparts system (docs/design.md section 6.3). Values are numbers in the component's declared unit, strings with units (e.g. '3.5 bar'), booleans, enum strings or tables (lists of rows; each cell a number in the declared column unit or a string with a unit). A component may also carry state values (for example a tank level) under states.",
  "type": "object",
  "additionalProperties": false,
  "required": ["worldparts_system", "name", "components"],
  "properties": {
    "worldparts_system": {"const": "0.1"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "simulation": {"$ref": "#/$defs/simulation"}
  },
  "$defs": {
    "instance_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "port_path": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"},
    "value": {
      "oneOf": [
        {"type": "number"},
        {"type": "string"},
        {"type": "boolean"},
        {"type": "array", "items": {"type": "array", "items": {"type": ["number", "string"]}}}
      ]
    },
    "values": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/value"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/instance_name"},
        "type": {"type": "string", "minLength": 1, "description": "Full component id or short alias."},
        "parameters": {"$ref": "#/$defs/values"},
        "inputs": {"$ref": "#/$defs/values"},
        "states": {"$ref": "#/$defs/values", "description": "Optional state values (declared units), applied after parameters and inputs."}
      }
    },
    "connection": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/port_path"}
    },
    "quantity": {"oneOf": [{"type": "number"}, {"type": "string", "minLength": 1}]},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "set"],
      "properties": {
        "at": {"$ref": "#/$defs/quantity"},
        "set": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/value"}}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration"],
      "properties": {
        "duration": {"$ref": "#/$defs/quantity"},
        "step": {"$ref": "#/$defs/quantity"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
      }
    }
  }
}
